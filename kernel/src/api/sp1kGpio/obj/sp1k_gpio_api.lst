 702           * @author    kai.wang
 703           * @since     2010-5-18
 704           * @todo      N/A
 705           * @bug       N/A
 706          */
 707          void sp1kSD_CdCfg(void)
 708          {
 709   1              //fmgpio4
 710   1              gpioDrivingSet(1, 0x01, 3);
 711   1              //fmgpio5
 712   1              gpioDrivingSet(1, 0x02, 3);
 713   1              //fmgpio6
 714   1              gpioDrivingSet(1, 0x04, 3);
 715   1              //fmgpio7
 716   1              gpioDrivingSet(1, 0x08, 3);
 717   1              //fmgpio8
 718   1              gpioDrivingSet(2, 0x01, 3);
 719   1              //fmgpio9
 720   1              gpioDrivingSet(2, 0x02, 3);
 721   1              
 722   1              #if USE_PKG_DEDICATE_PIN
 723   1              if((pkgChipIdGet() == 0x1627)||(pkgChipIdGet() == 0x1626))
 724   1              {
 725   2                      G_Detect_PinGrp = 0xff;//gpioByteIdSdCd;
 726   2                      G_Detect_PinMux = 0xff;//gpioBitMskSdCd;
 727   2                      if(HAL_GlobalICVerGet() == 0x01)
 728   2                      {
 729   3                              XBYTE[REG_Disp_Rsv0] |= 0x04;//dgpio use as card detect pin, enable HW DGPIO detect
 730   3                      }
 731   2                      else
 732   2                      {
 733   3                              XBYTE[REG_Disp_VsVdIntEn] |= 0x02;//dgpio use as card detect pin, enable INTR DGPIO detect
 734   3                      }
 735   2              }
C51 COMPILER V8.08   SP1K_GPIO_API                                                         09/19/2022 20:34:20 PAGE 13  

 736   1              else
 737   1              {
 738   2                      gpioByteFuncSet(GPIO_BYTE_GEN0, (1 << (1 & 0x07)), (1 << (1 & 0x07)));
 739   2                      gpioByteDirSet(GPIO_BYTE_GEN0, (1 << (1 & 0x07)), (1 << (0 & 0x07)));
 740   2                      pkgDedicateGpioCfg(PKG_DEDICATE_PIN_SD_CD, &gpioByteIdSdCd, &gpioBitMskSdCd, &gpioPolaritySdCd,0);
 741   2                      // gpioPullEnSet(4, 0x04, 0x04);  // gpio[1] pull high
 742   2                      
 743   2                      G_Detect_PinGrp = gpioByteIdSdCd;
 744   2                      G_Detect_PinMux = gpioBitMskSdCd;
 745   2              }
 746   1              #endif
 747   1      }
