 778   3                      }
 779   2              }
 780   1              else
 781   1              {
 782   2                      val = HAL_GpioByteInGet(gpioByteIdSdCd, gpioBitMskSdCd, gpioPolaritySdCd);
 783   2              }
 784   1              
 785   1              return  val;
 786   1              #endif
 787   1      }
