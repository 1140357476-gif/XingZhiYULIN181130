 765          {
 766   1              #if USE_PKG_DEDICATE_PIN
 767   1              UINT8 val=0;
 768   1              
 769   1              if((pkgChipIdGet() == 0x1627) || pkgChipIdGet()== 0x1626)
 770   1              {
 771   2                      if(HAL_GlobalICVerGet() == 0x01)
 772   2                      {
 773   3                              val = XBYTE[REG_Disp_Rsv3]&0x01;
 774   3                      }
 775   2                      else
