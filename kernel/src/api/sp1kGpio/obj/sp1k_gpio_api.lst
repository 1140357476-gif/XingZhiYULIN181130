1639          UINT16  sp1kADCValueSnap(void)
1640          {
1641   1              UINT16 adcVal;
1642   1              XBYTE[0x2603] |= 0x04;
1643   1              XBYTE[REG_Audio_SnapSarAdcVal0] = 0x01;
1644   1              while(!((XBYTE[0x2603]&0x04)>>2));
1645   1              XBYTE[0x2603] |= 0x04;
1646   1              *((UINT8*)&adcVal + 1) = XBYTE[REG_Audio_SnapSarAdcVal0];
1647   1              *((UINT8*)&adcVal + 0) = (XBYTE[REG_Audio_SnapSarAdcVal1]^0x02);
1648   1              return adcVal;
1649   1      }
1650          
1651          UINT16  sp1kADCValueSnapIntr(void)
