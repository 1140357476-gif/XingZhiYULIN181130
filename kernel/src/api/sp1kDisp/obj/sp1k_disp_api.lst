 240   3                      }
 241   2                      
 242   2                      dispPnlAspectRatioGet(&ratX, &ratY);
 243   2      
 244   2                      if (((UINT32)w * ratY) >= ((UINT32)ratX * h)) {
 245   3                              /* fit width */
 246   3                              h = ((UINT32)initH * h * ratX) / ((UINT32)w * ratY);
 247   3                              w = initW;
 248   3                      }
 249   2                      else {
 250   3                              /* fit height */
 251   3                              w = ((UINT32)initW * w * ratY) / ((UINT32)h * ratX);
 252   3                              h = initH;
 253   3                      }
 254   2              
 255   2                      //printf("new W: %lu,H: %lu\n ", (UINT32)w,(UINT32)h);
 256   2              if ((UINT32)((UINT32)w * initH) >= (UINT32)((UINT32)initW * h)) {
 257   3                  /* fit width */
 258   3                  hGap = 0;
 259   3                  vGap = (initH - (((UINT32)h * initW) / (UINT32)w) + 1) >> 1;
 260   3              } 
 261   2                      else {
