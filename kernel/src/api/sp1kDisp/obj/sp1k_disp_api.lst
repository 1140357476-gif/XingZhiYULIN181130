  55          void
  56          sp1kDispPnlOpen(
  57                  UINT8 panel
  58          )
  59          {
  60   1              devAttr_t* pDevAttr;
  61   1              UINT8 oldId;
  62   1      
  63   1      
  64   1              oldId = dispDevActGet();
  65   1              if ( panel == oldId ) {
  66   2                      return;
  67   2              }
  68   1      
  69   1              /* check the new panel id first */
  70   1              if (dispDevActSet(panel) != SUCCESS) {
  71   2                      return;
  72   2              } else {
  73   2                      /* restore the active id */
  74   2                      dispDevActSet(oldId);
  75   2              }
  76   1      
  77   1              dispPowerOff(oldId);
  78   1              dispDevActSet(panel);
  79   1              dispPowerOn(panel);
  80   1      
  81   1              pDevAttr = sp1kDevHdlGet();
  82   1      
  83   1              if ( panel > 1 ) {  /* tv. */
  84   2                      pDevAttr[DEV_ID_TV].devSts = DEV_STS_RDY;
  85   2                      pDevAttr[DEV_ID_TV].devEn = 1;
  86   2                      pDevAttr[DEV_ID_PANEL].devEn = 0;
  87   2              }
  88   1              else {  /* panel. */
  89   2                      pDevAttr[DEV_ID_PANEL].devSts = DEV_STS_RDY;
  90   2                      pDevAttr[DEV_ID_TV].devEn = 0;
  91   2                      pDevAttr[DEV_ID_PANEL].devEn = 1;
  92   2              }
  93   1      }
