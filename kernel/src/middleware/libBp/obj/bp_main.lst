 189          static UINT8 bpRawWrite(UINT32 addr, UINT32 width, UINT32 xPos, UINT32 yPos, UINT16 prgb)
 190          {
 191   1              UINT32 offset;
 192   1              const UINT16 bytePerPixel = 1; /* the data length raw is 8bits */
 193   1              UINT16 raw;
 194   1      
 195   1              offset = (yPos * width + xPos) * bytePerPixel;
 196   1      
 197   1              addr += (offset >> 1);  
 198   1              
 199   1      #if BP_ASSERT_EN        
 200   1              if (addr <= K_SDRAM_CommonEndAddr || addr >= K_SDRAM_TotalSize) {
 201   2                      __ASSERT(__FILE, __LINE, 1);
 202   2                      return FAIL;
 203   2              }       
 204   1      #endif //BP_ASSERT_EN   
 205   1      
 206   1              BP_DRAM_SetStartAddress(addr, 1);       
