 363   1              if ((xoff == 0) || (xoff == 1)) {
C51 COMPILER V8.08   BP_MAIN                                                               10/17/2019 11:40:32 PAGE 7   

 364   2                      if ((yoff == 0) || (yoff == 1)) {
 365   3                              //printf("left and top!\n");
 366   3                              ret = SUCCESS;
 367   3                      } else {
 368   3                              /* read */ /* Use the pixel above two line */
 369   3                              ret = bpRawRead(addr, Hsize, xoff, yoff - 2, &readvalue);
 370   3      
 371   3                              /* copy */
