 129          */
 130          static UINT8 bpRawRead(UINT32 addr, UINT32 width, UINT32 xPos, UINT32 yPos, UINT16* prgb)
 131          {
 132   1              UINT32 offset;
 133   1              const UINT16 bytePerPixel = 1; /* the data length raw is 8bits */
 134   1      
 135   1              if (!prgb) {
 136   2                      return FAIL;
 137   2              }
 138   1      
 139   1              offset = (yPos * width + xPos) * bytePerPixel;
 140   1              addr += (offset >> 1);
 141   1      
 142   1      #if BP_ASSERT_EN
 143   1              if (addr <= K_SDRAM_CommonEndAddr || addr >= K_SDRAM_TotalSize) {
 144   2      printf("xPos: %lx\n", (UINT32)xPos);
 145   2      printf("yPos: %lx\n", (UINT32)yPos);
 146   2      printf("offset: %lx\n", (UINT32)offset);
 147   2      printf("addr: %lx\n", (UINT32)addr);
 148   2                      __ASSERT(__FILE, __LINE, 1);
 149   2                      return FAIL;
 150   2              }       
 151   1      #endif //BP_ASSERT_EN
 152   1      
 153   1              BP_DRAM_SetStartAddress(addr, 1);
 154   1      
 155   1              if (offset & 0x01) {
 156   2                      /* the raw data is in high byte */
 157   2                      BP_DRAM_ReadPword((UINT8 *) prgb, ((UINT8 *) prgb) + 1);
 158   2              } else {
 159   2                      /* the raw data is in low byte */
 160   2                      BP_DRAM_ReadPword(((UINT8 *) prgb) + 1, (UINT8 *) prgb);
 161   2              }
 162   1              WRITEP8(prgb, 0, 0);
 163   1              
 164   1      #if DBG_BP_EN
                      printf("read X(%lu), Y(%lu) : %u\n", xPos, yPos, *prgb);
              #endif
 167   1      
 168   1              return SUCCESS;
 169   1      }
