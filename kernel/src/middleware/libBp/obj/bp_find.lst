              #endif //DBG_BP_EN
                                              }
                                              //else {
                                              //      bpBadPixelFlagSave(0x00,startX + (j - 2) * g_planeWidth + (i << 1), (startY + (k << 1)) ,s_bpBadpix
             -elFlagAddr);
                                              //}
