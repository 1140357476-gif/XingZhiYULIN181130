             -lFlagAddr);
                                                      type=bpTypeGet(startX,off-1,mode);
                                                      bpBadPixelAddrSet(s_bpBadpixelAddr, 0); 
                                                      bpBadPixelSave(startX + (j - 2) * g_planeWidth + (i << 1), (startY + (k << 1)));
                                                      
                                                      s_bpBadpixelAddr +=2;
              #if DBG_BP_EN
