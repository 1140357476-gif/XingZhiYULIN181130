                                      avg2 = (UINT8) (avgBuf[j++]);
                                      for (i = 0; i < g_planeWidth; i ++) {
                                              val = G_ucStorData[off++];
                                              diff = ABS(val, avg1); 
                                              if (diff > g_threshold) {
