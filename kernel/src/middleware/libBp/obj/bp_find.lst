  83          #else
              
              #define bpBadPixelAddrSet(A,B)\
                      HAL_DramStartAddrSet((UINT32)A, B);     
              
              #define bpBadPixelSave(X, Y) \
                      if(g_badPixelCnt != *gp_bpNumMax){\
                              g_badPixelCnt ++;       \
                              HAL_DramWordDataWrite((UINT8)((X)>>8), (UINT8)(X)); \
                              HAL_DramWordDataWrite((UINT8)((Y)>>8), (UINT8)(Y)); \
                      }
                      
              #endif
  96                  
