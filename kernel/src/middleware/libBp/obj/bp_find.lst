                      UINT8 i, j, k;
                      UINT16 type;
                      cnt = g_stripWidth / g_planeWidth;
                      bpStripAvgs(avgBuf, cnt);
              
                      off = 0;
                      for (k = 0; k < g_stripHeight; k ++) {
                              for (j = 0; j < cnt;) {
