 148          void
 149          afWinCfg(
 150                  UINT16 frontHSize,
 151                  UINT16 frontVSize,
 152                  UINT16 cropHSize,
 153                  UINT16 cropVSize
 154          )
 155          {
 156   1              
 157   1              UINT16 afHShift,afVShift;
 158   1              UINT16 afHStart,afHEnd,afVStart,afVEnd;
 159   1      
 160   1              /* AF filter 1/2 weight */
 161   1              HAL_CdspAFFilterWtSet(afPara.afFlt1Wt,afPara.afFlt2Wt);
 162   1      
 163   1              /* AF statistic data mode, AF pg type */
 164   1              HAL_CdspAFDataModeSet(afPara.afRgbMode,afPara.afPgType);
 165   1      
