                      for(i=0;i<4;i+=1){
                              printf("-%bx-(%x,%x)\n",i,ctc[i],ctc[i+4]);
                      }
                      for(i=0;i<48;i+=4){
                              printf("-%bx-(%x,%x,%x,%x)\n",i/4,rects[i],rects[i+1],rects[i+2],rects[i+3]);
                      }
              }
              #endif
 464   1      return AWB_ADDR_Ctt;
 465   1      
 466   1      }


