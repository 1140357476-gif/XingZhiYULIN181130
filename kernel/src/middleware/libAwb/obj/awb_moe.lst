                      cmd.min = 0;
                      cmd.src1Shift = 8;
                      cmd.src2Shift = 6;
                      cmd.dstShift = 0;
                      cmd.dstBit = 1;
                      cmd.src1 = AWB_ADDR_G;/*AWB_ADDR_MOE_samp+512*///tmp[4];//g
                      cmd.src2 = AWB_ADDR_R;/*AWB_ADDR_MOE_samp*///tmp[cr];
                      cmd.dst = AWB_ADDR_RGain;
                      HAL_MoeConvertToQueue(&cmd, &(pt->rg));
                      cmd.src2 = AWB_ADDR_B;/*AWB_ADDR_MOE_samp+1024*///tmp[cb];
