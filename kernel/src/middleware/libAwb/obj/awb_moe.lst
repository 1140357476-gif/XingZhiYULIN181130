1192   1              moeCpWrite(ptRect->rect_up,     rect[i+3]);
1193   1      }
1194          void awbConvertCT2Gain(UINT16 ct,UINT16* rg,UINT16* bg,UINT16* gain,UINT16* thr)
1195          {
1196   1              //2000K: thr[0],thr[8+1]
1197   1              //2500K: gain[0],gain[4]
1198   1              //4500K: gain[1],gain[5]
1199   1              //6500K: gain[2],gain[6]
1200   1              //7000K: thr[5],thr[8+4]
1201   1              UINT16 c0 = 2000, x0 = thr[0],y0=thr[8+1];
1202   1              UINT16 c1 = 4500, x1 = gain[1], y1=gain[1];
1203   1              UINT16 c2 = 7000, x2 = thr[5], y2 = thr[8+4];
1204   1      //      UINT16 rg0,rg1,bg0,bg1;
1205   1              
1206   1      
1207   1              if(ct<4500){
1208   2                      if(ct<2000){ct=2000;}
1209   2                      *rg = x1-(UINT32)(c1-ct)*(x1-x0)/(c1-c0);
1210   2                      *bg = y1+(UINT32)(c1-ct)*(y0-y1)/(c1-c0);       
1211   2              }
1212   1              else {
1213   2                      if(ct>7000){ct=7000;}
1214   2                      *rg = x1+(UINT32)(ct-c1)*(x2-x1)/(c2-c1);
1215   2                      *bg = y1-(UINT32)(ct-c1)*(y1-y2)/(c2-c1);                               
1216   2              }
1217   1              printf("ct:%u k(%x,%x)\n",ct,*rg,*bg);
1218   1      }
