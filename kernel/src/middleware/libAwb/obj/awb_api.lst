  86          /**
  87           * @fn        UINT16 awbGlobleGainSetIntr(UINT16 gain)
  88           * @brief     set globe gain* awb gain  to cdsp(using for Intr)
  89           * @param     [in] gain :base on 256, if gain==0xffff,return globle gain only
  90           * @retval    last globle gain
  91           * @see       NULL
  92           * @author    wangjg
  93           * @since     2010-5-4
  94           * @todo      N/A
  95           * @bug       N/A
  96          */
  97          UINT16 
  98          awbGlobeGainSetIntr(
  99                  UINT16 gain
 100                  )
 101          {
 102   1              if(gain==0){
 103   2                      if(awb.newGain==1){//update gain for VD Rising 
 104   3                              awbGainSetIntr(0xffff, 0xffff);
 105   3                              awb.newGain=0;
 106   3                      }
 107   2              }else if(gain!=0xffff){
 108   2                      awb.globeGain = gain;
 109   2                      awbGainSetIntr(0xffff, 0xffff); 
 110   2                      awb.newGain=0;
 111   2              }
 112   1              return awb.globeGain;
 113   1      }
