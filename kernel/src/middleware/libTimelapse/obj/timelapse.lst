 636          static void timelapse_InitHdr(UINT32 hdrAddrW, UINT16 width, UINT16 height)
 637          {
 638   1              UINT32 tmp32;
 639   1              
 640   1              sp1kNandRsvRead(RES_AVIHeader_PCM, hdrAddrW<<1);
 641   1      
 642   1              //for test
 643   1              tmp32 = 512;
 644   1              timelapse_FillDramLong(hdrAddrW+(0x04>>1), tmp32);
 645   1      
 646   1              //mainHeader: dwMicroSecPerFrame
 647   1              if(!timelapseParam[TIMELAPSE_PAR_FPS]){
 648   2                      timelapseParam[TIMELAPSE_PAR_FPS] = 2;//default frame = 2
 649   2              }
 650   1              tmp32 = 1000000/timelapseParam[TIMELAPSE_PAR_FPS];
 651   1              timelapse_FillDramLong(hdrAddrW+(0x20>>1), tmp32);
 652   1              //streams, mask aud stream
 653   1              tmp32 = 1;
 654   1              timelapse_FillDramLong(hdrAddrW+(0x38>>1), tmp32);
 655   1              //width, height
 656   1              timelapse_FillDramLong(hdrAddrW+(0x40>>1), width);
 657   1              timelapse_FillDramLong(hdrAddrW+(0x44>>1), height);
 658   1              
 659   1              //strh: reserved3
 660   1              tmp32 = height;
 661   1              tmp32 = (tmp32 << 16) + width;
 662   1              timelapse_FillDramLong(hdrAddrW+(0xA0>>1), tmp32);
 663   1      
 664   1              //strf:widht, height
 665   1              timelapse_FillDramLong(hdrAddrW+(0xB0>>1), width);
 666   1              timelapse_FillDramLong(hdrAddrW+(0xB4>>1), height);
 667   1              //biSizeImage
 668   1              tmp32 = (UINT32)width*height*3;
 669   1              timelapse_FillDramLong(hdrAddrW+(0xC0>>1), tmp32);
 670   1      
C51 COMPILER V8.08   TIMELAPSE                                                             12/31/2019 16:16:09 PAGE 12  

 671   1              //mask aud stream
 672   1              tmp32 = 0x4B4E554A; //JUNK
 673   1              timelapse_FillDramLong(hdrAddrW+(0xD4>>1), tmp32);      
 674   1      
 675   1              //modidy audio stream flag
 676   1              tmp32 = 0x7364756E;//nuds//0x66736C74;//tlsf
 677   1              timelapse_FillDramLong(hdrAddrW+(0xE8>>1), tmp32);      
 678   1              
 679   1              //custom info
 680   1              tmp32 = timelapseParam[TIMELAPSE_PAR_SNAPGAP];
 681   1              HAL_DramSetAddr(hdrAddrW+(CUSTOM_INFO_OFFSET>>1), K_SDRAM_NoPrefetch );
 682   1              HAL_DramWordDataWrite((UINT8)tmp32,(UINT8)(tmp32>>8));
 683   1      }
