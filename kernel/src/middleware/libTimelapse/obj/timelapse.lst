 739          UINT8 timelapse_Entry(UINT32 dramAddrW, UINT16 width, UINT16 height,UINT32 vlcSize)
 740          {
 741   1              UINT32 freeSize;
 742   1              UINT32 offset;
 743   1              timelapseAvi_t avi;
 744   1              UINT8 fd;
 745   1              UINT8 aviName[12];
 746   1              UINT32 sizeByCluster = 0;
 747   1              UINT32 clusterSize;
 748   1              UINT32 realSize,tmp;
 749   1              UINT32 aviSize;
 750   1              UINT32 junkSize,junkOffset;
 751   1      
 752   1              dbgCnt = 1;
 753   1              if( dcfTLSAssignFolder()){
 754   2                      return FAIL;
 755   2                      //printf("fail:L=%d\n",__LINE__);
 756   2              }
 757   1              
 758   1              freeSize = DOS_GetDiskSpace();
 759   1              if(freeSize < 0x800 ){ // reserved size 0x200000
 760   2                      return FAIL;
 761   2              }
 762   1              dcfFileIndexUpdate();
 763   1              /* rename AVI name */
 764   1              dcfMediaNameGet(aviName, G_USR_FileIndex,MEDIA_TLS);
 765   1              fd = DOS_FileOpen(aviName, 'w');
 766   1              if (fd == 0){
 767   2                      return FAIL;
 768   2              }
 769   1              avi.moviOffset = 4;
 770   1              clusterSize = DOS_ClusterSizeGet();
 771   1      
 772   1              /* reverse some space for avi header */
 773   1              dramAddrW = dramAddrW- ((clusterSize+MOVI_LIST_HDR_SIZE)>>1);
 774   1      
 775   1              /* movi list 0x4C 49 53 54  F8 FF 4B 00   6D 6F 76 69 ,20 bytes */
 776   1              tmp= (vlcSize + MOVI_LIST_HDR_SIZE + clusterSize-1)&~(clusterSize-1);//cluster aligment
 777   1              realSize = tmp - MOVI_LIST_HDR_SIZE -8; //not include 0xdc
 778   1      
 779   1              /* load avi header List and init header */
 780   1              timelapse_InitHdr(dramAddrW, width, height);
 781   1              /* Write header index */
 782   1              timelapse_WriteIdxToDram(dramAddrW+(HDRIDXOFFSET>>1));
 783   1              timelapse_FillDramLong(dramAddrW +(HDRIDXOFFSET>>1)+ 2, 16);
 784   1              timelapseWriteVidIndex2Dram(avi.moviOffset, realSize, dramAddrW +(HDRIDXOFFSET>>1)+ 4);
 785   1              
 786   1              sizeByCluster += clusterSize;
 787   1              /* load movi List */
 788   1              offset = clusterSize>>1;
 789   1              sizeByCluster +=tmp;
 790   1              timelapse_WriteMoviToDram(dramAddrW+offset);
 791   1              //timelapse_FillDramLong(dramAddrW + offset + 6, 0x63643030);
 792   1              timelapse_FillDramLong(dramAddrW + offset + 6 + 2, realSize);
C51 COMPILER V8.08   TIMELAPSE                                                             12/31/2019 16:16:09 PAGE 14  

 793   1              
 794   1              /* Add movi junk */
 795   1              tmp = (vlcSize+1)&~1;
 796   1              junkSize = (tmp+12) % clusterSize;
 797   1              junkSize = clusterSize - junkSize;
 798   1              junkOffset = offset +(tmp+12)/2;
 799   1              if(junkSize){
 800   2                      HAL_GprmDramFill(dramAddrW+junkOffset, junkSize, 0);
 801   2              }
 802   1              
 803   1              /* Write to card */
 804   1              DOS_FileWrite(fd,dramAddrW<<1,sizeByCluster);
 805   1              avi.hdr_Last_Cluster = dos.file[fd].FirstCluster;
 806   1              avi.hdr_Start_Cluster = avi.hdr_Last_Cluster;
 807   1              avi.movi_Last_Cluster = dos.file[fd].LastCluster;
 808   1              avi.movi_Start_Cluster = FAT_TableRead(dos.CurrDrv,avi.hdr_Last_Cluster);
 809   1              avi.hdrIdxOffset = HDRIDXOFFSET+ 8+16;
 810   1              avi.hdrIdxSkipCluster = 0;
 811   1              
 812   1              /* Write index */
 813   1              DOS_FileSeek(fd, 0, SEEK_END);
 814   1              timelapse_WriteIdxToDram(dramAddrW);
 815   1              timelapse_FillDramLong(dramAddrW + 2, 16);
 816   1              timelapseWriteVidIndex2Dram(avi.moviOffset, realSize, dramAddrW + 4);
 817   1              DOS_FileWrite(fd,dramAddrW<<1,24);
 818   1              avi.idx_Last_Cluster = dos.file[fd].LastCluster;
 819   1              avi.idx_Start_Cluster = avi.idx_Last_Cluster;
 820   1              
 821   1              /* modify header */
 822   1              avi.moviOffset += realSize;
 823   1              avi.idxSize = 16;       
 824   1      
 825   1              timelapse_ModifyMovi(fd,dramAddrW,realSize+8,avi.movi_Start_Cluster);
 826   1              timelapse_ModifyHdr(fd,dramAddrW,avi.hdr_Start_Cluster,avi.movi_Start_Cluster,avi.idx_Start_Cluster,avi.h
             -drIdxSkipCluster);
 827   1              
 828   1              /* Save AVI information */
 829   1              timelapse_CheckSum_Get(&avi);
 830   1              timelapse_WriteAviInfo(fd,dramAddrW,avi);
 831   1              aviSize = vfsFileSizeGet(fd);
 832   1              DOS_FileClose(fd);
 833   1              
 834   1              dcfFileIndexUpdate();
 835   1              dcfNewFileDramFdbParameterUpdate(K_DCF_WGI_TYPE ,aviSize);
 836   1      
 837   1              return SUCCESS;
 838   1      }
