 731          static void timelapse_ModifyMovi( UINT8 fd, UINT32 dramAddrW,UINT32 moviSize,UINT32 moviCluster)
 732          {       
 733   1              timelapse_FileRead(fd,dramAddrW<<1,0x200,0,moviCluster);
 734   1              timelapse_FillDramLong(dramAddrW + 2, moviSize +4 );
 735   1              timelapse_FileWrite(fd,dramAddrW<<1,0x200,0,moviCluster);
 736   1      }
