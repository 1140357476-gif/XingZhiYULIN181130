 258          static UINT8 timelapse_DiskCheck( UINT8 fno,UINT32 movSize)
 259          {       
 260   1              UINT32 clusterSize;
 261   1              UINT32 freeSize;
 262   1              UINT32 usedSize;
 263   1              UINT32 reqSize;
 264   1      
 265   1              clusterSize = DOS_ClusterSizeGet();     //Byte
 266   1              freeSize = DOS_GetDiskSpace();//Kb
 267   1              
 268   1              reqSize = (movSize + clusterSize)>>10;//Kb
 269   1              usedSize = dos.file[fno].size>>10;//Kb
 270   1              usedSize += reqSize;
 271   1              
 272   1              if (reqSize> freeSize) {
 273   2                      //osMsgPost(SP1K_MSG_MEDIA_REC_DISK_FULL);
 274   2                      printf("Card full!!\n");
 275   2                      return TIMELAPSE_CARDFULL;
 276   2              }
 277   1      
 278   1              if(usedSize >=( SD_Size_4G>>10)){
 279   2                      //osMsgPost(SP1K_MSG_MEDIA_REC_DISK_FULL);
 280   2                      printf("File size > 4G!!!\n");
 281   2                      return TIMELAPSE_MAX_FILESIZE;
 282   2              }
 283   1              
 284   1              return TIMELAPSE_SUCCESS;
 285   1      }
