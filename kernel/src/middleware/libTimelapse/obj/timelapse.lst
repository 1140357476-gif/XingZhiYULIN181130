 685          static void timelapse_ModifyHdr( UINT8 fno,UINT32 dramAddrW,UINT32 hdrCluster,UINT32 movCluster,UINT32 idx
             -Cluster,UINT32 cnt)
 686          {
 687   1              UINT32 fileSize;
 688   1              UINT32 frames, scale, rate, fps;
 689   1              UINT32 hdrSize;
 690   1              UINT32 clusterSize;
 691   1              UINT32 movSize,idxSize;
 692   1              
 693   1              clusterSize = DOS_ClusterSizeGet();
 694   1              hdrSize = clusterSize*(cnt+1);
 695   1      
 696   1              /* Read movi List size */
 697   1              timelapse_FileRead(fno,dramAddrW<<1,0x200,0,movCluster);
 698   1              timelapse_ReadDram(dramAddrW + 2,(UINT8*)&movSize,sizeof(UINT32),2);
 699   1              movSize+=8;
 700   1      
 701   1              /* Read index List size */
 702   1              timelapse_FileRead(fno,dramAddrW<<1,0x200,0,idxCluster);
 703   1              timelapse_ReadDram(dramAddrW + 2,(UINT8*)&idxSize,sizeof(UINT32),2);
 704   1      
 705   1              /* Read AVI header */
 706   1              timelapse_FileRead(fno,dramAddrW<<1,1024,0,hdrCluster);
 707   1      
 708   1              //printf("mov=%lx,idx=%lx\n",movSize,idxSize);
 709   1              fileSize = hdrSize + movSize + (idxSize+8) - 8;// avi.hdrSize + avi.moviSize + (avi.lastIdxSize + 8) - 8;
 710   1              timelapse_FillDramLong(dramAddrW+(4>>1), fileSize);
 711   1              hdrSize = hdrSize - 0x14;       
 712   1              timelapse_FillDramLong(dramAddrW+(0x10>>1),hdrSize);
 713   1              
 714   1              frames = idxSize / 16; // no audio
 715   1              fps = videoPbReadDword(dramAddrW+ (0x20>>1));
 716   1              rate = 1000000;//frames * 1000 ;
 717   1              scale = fps; //(UINT32)((float)fps * frames / 1000);
 718   1                      
 719   1              timelapse_FillDramLong(dramAddrW+(0x30>>1), frames);
 720   1              timelapse_FillDramLong(dramAddrW+(0x80>>1), scale);
 721   1              timelapse_FillDramLong(dramAddrW+(0x84>>1), rate);
 722   1              timelapse_FillDramLong(dramAddrW+(0x8C>>1), frames);
 723   1      
 724   1              /* cluster size - 0x140; real junk include index and cluster alignment  */
 725   1              timelapse_FillDramLong(dramAddrW+(0x13C>>1), hdrSize-0x140+0x14);//videoFillDramLong(dramAddrW+(0x13C>>1)
             -, junkSize);
 726   1              timelapse_FillDramLong(dramAddrW+(0x204>>1), idxSize);
 727   1      
 728   1              timelapse_FileWrite(fno,dramAddrW<<1,1024,0,hdrCluster);
 729   1      }
