 419          static UINT8 timelapse_ExpendSpace(UINT8 fno,UINT32 dataAddr, UINT32 *lstCluster,UINT32 dataLenth)
 420          {
 421   1              UINT32 startCluster,currCluser=0,nextCluster,firstCluster;
 422   1              UINT32 gainCluster,datClusterCnt,clusterSize;
 423   1              UINT32 sector;
 424   1              UINT8 i;
C51 COMPILER V8.08   TIMELAPSE                                                             12/31/2019 16:16:09 PAGE 8   

 425   1              UINT8 sts = SUCCESS;
 426   1      
 427   1              clusterSize = DOS_ClusterSizeGet();
 428   1              datClusterCnt = dataLenth/clusterSize;
 429   1          //printf("need=%ld\n",datClusterCnt);
 430   1              while(datClusterCnt){
 431   2                       gainCluster = FAT_FreeClusterGet(dos.CurrDrv,datClusterCnt,&nextCluster);
 432   2                      // printf("get=%ld\n",gainCluster);
 433   2                       startCluster = nextCluster;
 434   2                       if(currCluser==0){
 435   3                              currCluser =nextCluster++;
 436   3                              i=1;
 437   3                              firstCluster = currCluser;
 438   3                       }
 439   2                       else{
 440   3                              i=0;
 441   3                       }
 442   2                       
 443   2                      /* create FAT list ... */
 444   2                      for(;i<gainCluster;i++){        
 445   3                              //printf("%bu,%lx->%lx\n",i,currCluser,nextCluster);
 446   3                              FAT_TableWrite(dos.CurrDrv, currCluser, nextCluster);
 447   3                              currCluser = nextCluster++;
 448   3                      }
 449   2                      
 450   2                      FAT_TableWrite(dos.CurrDrv, currCluser, dos.disk.FAT_EOFValue);
 451   2                      sector = FAT_Cluster2Sector(dos.CurrDrv, startCluster); 
 452   2                      sts = DOS_SectorWrite(dos.CurrDrv,sector,(UINT32)gainCluster*clusterSize/512,dataAddr); 
 453   2                      if(sts != TRUE){
 454   3                              //printf("write error:Line=%d\n",__LINE__);
 455   3                              return FAIL;
 456   3                      }
 457   2                      dataAddr+=(UINT32)gainCluster*clusterSize/2;
 458   2                      if( gainCluster>=datClusterCnt ){
 459   3                              break;
 460   3                      }
 461   2                       datClusterCnt -= gainCluster;
 462   2              }
 463   1              
 464   1              nextCluster = FAT_TableRead(dos.CurrDrv,*lstCluster);
 465   1              FAT_TableWrite(dos.CurrDrv,*lstCluster,firstCluster);
 466   1              FAT_TableWrite(dos.CurrDrv,currCluser,nextCluster);
 467   1              
 468   1              dos.file[fno].size+=dataLenth;
 469   1              *lstCluster = currCluser;//return last cluster
 470   1      
 471   1              return SUCCESS;
 472   1      }
