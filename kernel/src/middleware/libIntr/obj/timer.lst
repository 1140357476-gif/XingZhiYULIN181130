 196          void TIMER1_Config(UINT32 Period, pFuncTmr1 pFunc, UINT8* pFuncPara)
 197          {
 198   1              UINT32 CpuClk;
 199   1              
 200   1              TMOD &= 0x0f;
 201   1              TMOD |= 0x10;
 202   1              TF1=0;
 203   1                              
 204   1              if ((!Period) || (pFunc == (void (*)())NULL)) {
 205   2                      return;
 206   2              }
 207   1      
 208   1              Tmr1ReloadVal = Period;
 209   1              Tmr1PFunc = pFunc;
 210   1              Tmr1PFuncPara = pFuncPara;
 211   1      
 212   1              CpuClk=522000000UL/(XBYTE[0x2024]+1);
 213   1      
 214   1              InitVal = 65536UL -  CpuClk / 12000UL;
 215   1              TimeTick = Tmr1ReloadVal;
 216   1              TL1 = READ8(InitVal, 3);
 217   1              TH1 = READ8(InitVal, 2);
 218   1              
 219   1      }
