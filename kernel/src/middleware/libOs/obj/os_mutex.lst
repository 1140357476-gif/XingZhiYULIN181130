C51 COMPILER V8.12   OS_MUTEX                                                              12/29/2014 15:17:56 PAGE 3   

 116          */
 117          #pragma disable //disable interrupt
 118          UINT8
 119          osMutexGet(
 120                  osMutexIdx_t mutex
 121          )
 122          {
 123   1              if (osMutexQuery(mutex) == SUCCESS) {
 124   2                      osMutex &= ~(0x01 << mutex);
 125   2                      return SUCCESS;
 126   2              }
 127   1              
 128   1              return FAIL;
 129   1      }
