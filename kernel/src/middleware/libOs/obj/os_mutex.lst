 142          #pragma disable //disable interrupt
 143          void
 144          osMutexFree(
 145                  osMutexIdx_t mutex
 146          )
 147          {
 148   1              if (mutex < OS_MUTEX_MAX) {
 149   2                      osMutex |= (0x01 << mutex);
 150   2              }
 151   1      }


