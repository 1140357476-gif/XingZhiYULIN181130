  59          /**
  60           * @fn        void osMutexInit(void)
  61           * @brief     initialize the mutex buffer
  62           * @param     NONE
  63           * @retval    NONE
  64           * @see       NULL
  65           * @author    Phil Lin
  66           * @since     2011-4-1
  67           * @todo      N/A
  68           * @bug       N/A
  69          */
  70          #pragma disable //disable interrupt
  71          void
  72          osMutexInit(
  73                  void
  74          )
  75          {
  76   1              osMutex = -1;
  77   1      }
  78          
  79          /**
  80           * @fn        UINT8 osMutexQuery(osMutexIdx_t mutex)
  81           * @brief     Query the specified mutex
  82           * @param     [in] mutex
  83           * @retval    return = SUCCESS / FAIL
  84           * @see       NULL
  85           * @author    Phil Lin
  86           * @since     2011-4-1
  87           * @todo      N/A
  88           * @bug       N/A
  89          */
  90          #pragma disable //disable interrupt
  91          UINT8
  92          osMutexQuery(
  93                  osMutexIdx_t mutex
  94          )
  95          {
  96   1              if (mutex >= OS_MUTEX_MAX) {
  97   2                      return FAIL;
  98   2              }
  99   1              
 100   1              if (osMutex & (0x01 << mutex)) {                
 101   2                      return SUCCESS;
 102   2              }
 103   1      
 104   1              return FAIL;
 105   1      }
 106          /**
 107           * @fn        UINT8 osMutexGet(osMutexIdx_t mutex)
 108           * @brief     Get the specified mutex
 109           * @param     [in] mutex
