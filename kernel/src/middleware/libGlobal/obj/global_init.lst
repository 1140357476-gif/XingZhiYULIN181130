 332   1          XBYTE[REG_Usb_LogicEp1_Disable] = 0xe0;  //0x2530
 333   1      #else
                  XBYTE[REG_Usb_Alt_If1_NumMax] = 0x08;                       /* Set alternating max to 8 */
                  XBYTE[REG_Usb_UsbMode] = 0x03;
                  XBYTE[REG_Usb_LogicEp1_Disable] = 0x00;
              #endif
 338   1      
 339   1              HAL_UsbSwPlugOut();
 340   1          G_UI_USBConnect = K_UI_USB_DISCONNECT;
 341   1      }
