 310   1                                                                              //next EP0 In packet
 311   1      
 312   1              XBYTE[REG_Usb_EpAckIntSts] = 0xff;                      //Clear all status
 313   1              XBYTE[REG_Usb_IntSts] = 0xff;                   //clear status
 314   1              XBYTE[REG_Usb_EpAckIntEn] = 0x07;                       //enable interrupt for
 315   1                                                                              //EP0 Setup packet OK
 316   1                                                                              //EP0 Out packet OK
 317   1                                                                              //EP0 In packet OK
 318   1              XBYTE[REG_Usb_IntEn] |= 0x01;                   //USBRstVTEn
 319   1      #if 1
