 325   1              //XBYTE[0x207B] &= ~0x01;                       //clear GPIO8 Finter event
 326   1              XBYTE[0x2044] |= 0x08;                  //enable GPIO3 Falling interrupt (USB detcter)
 327   1              XBYTE[0x207A] &= ~0x08;                 //clear GPIO3 Finter event
