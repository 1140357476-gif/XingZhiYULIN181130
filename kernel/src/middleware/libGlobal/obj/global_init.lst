 188          static void
 189          dramInit(
 190                  void
 191          )
 192          {
 193   1              /* Dram access priority setting */
 194   1              XBYTE[REG_Dram_Master0b_Sel] = 0x00;    /* set CDSP priority more than display */
 195   1      
 196   1              XBYTE[REG_Dram_SdckMode] &= ~0x40;/*ma14 output enable,must set when dram is 16*16*/
 197   1              /* Code sentry setting */ //Phil move to "sysMemAddrUpdate"
 198   1              /* protect 1 word firstly, then for all code area after system memeory initial */
 199   1              HAL_DramCodeSentry(0x00, 0x00, 0x00);
 200   1      
 201   1              /* watch dog timer initial */
 202   1              dbgWdtCfg(1, WDT_PROC_DBG_ALL, WDT_TIME_OUT);
 203   1      
 204   1              /* global timer initial */
 205   1              HAL_GlobalTimerInit();
 206   1      }
