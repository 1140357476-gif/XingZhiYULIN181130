 124          /**
 125           * @fn        void cpuInit(void)
 126           * @brief     cpuInit
 127           * @param     NONE
 128           * @retval    NONE
 129           * @see       NULL
 130           * @author    Phil Lin
 131           * @since     2011-2-15
 132           * @todo      N/A
 133           * @bug       N/A
 134          */
 135          static void
 136          cpuInit(
 137                  void
 138          )
 139          {
 140   1          TCON = 0x40;                    //TCON:  IT0=0 INT0 negative edge trigger
 141   1                                          //       IE0=0 INT0 interrupt flag
 142   1                                          //       IT1=0 INT1 negative level trigger
 143   1                                          //       IE1=0 INT1 interrupt flag
 144   1                                          //       TR0=0 TIMER0 disable
 145   1                                          //       TF0=0 TIMER0 overflow flag
 146   1                                          //       TR1=1 TIMER1 enable
 147   1                                          //       TF1=0 TIMER1 overflow flag
 148   1      
 149   1          IP = 0x03;                      //IP:    PX0=1 INT0 priority level
 150   1                                          //       PT0=1 TIMER0 priority level
 151   1                                          //       PX1=0 INT1 priority level
 152   1                                          //       PT1=0 TIMER1 priority level
 153   1                                          //       PS=0  Serial Port priority level
 154   1                                          //       PT2=0 Timer2 priority level
 155   1      
 156   1          IE = 0x81;                      //IE:    EX0=1 INT0 interrupt enable
 157   1                                          //       ET0=0 TIMER0 interrupt disable
 158   1                                          //       EX1=0 INT1 interrupt disable
 159   1                                          //       ET1=0 TIMER1 interrupt disable
 160   1                                          //       ES=0  Serial Port interrupt disable
 161   1                                          //       ET2=0 TIMER2 interrupt disable
 162   1                                          //       EA=1  All interrupts enable
 163   1      
 164   1          TMOD = 0x11;                    //TMOD:  Timer0 M1M0=1 (Mode1=16-bit counter)
 165   1                                          //       Timer0 C/T~=0 (Timer)
 166   1                                          //       Timer0 GATE=0
 167   1                                          //       Timer1 M1M0=2 (Mode2=8-bit counter)
 168   1                                          //       Timer1 C/T~=0 (Timer)
 169   1                                          //       Timer1 GATE=0
 170   1      
 171   1              IT1 = 1;                                                // it determines the EX1 trigger method
 172   1      
 173   1              TH1 = K_Timer1IntervalHi;
 174   1              TL1 = K_Timer1IntervalLo;
 175   1      }
