 232   2                      XBYTE[0x204A] = 0x56;
 233   2                      XBYTE[0x2060] = 0x56;//mantis for 42697
 234   2              }
 235   1      
 236   1              #ifndef LIB_RELEASE
                              #if(_HW_SOLUTION_ == _HW_EVB_)
                                      XBYTE[0x2048] = 0x75;//only increasing driving for EVB
                              #endif
