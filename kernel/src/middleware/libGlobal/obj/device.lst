  62          //-----------------------------------------------------------------------------
  63          // sp1kDevInit
  64          //-----------------------------------------------------------------------------
  65          /**
  66           * @fn        UINT8 sp1kDevInit(void)
  67           * @brief     sp1kDevInit
  68           * @param     NONE
  69           * @retval    return = SUCCESS / FAIL
  70           * @see       NULL
  71           * @author    Phil Lin
  72           * @since     2010-5-21
  73           * @todo      N/A
  74           * @bug       N/A
  75          */
  76          UINT8 sp1kDevInit(void)
  77          {
  78   1              devAttr_t* pDev = sSysDev;
  79   1              UINT8 DevNum = DEV_ID_MAX;
  80   1              UINT8 i;
  81   1      
  82   1              for (i = 0; i < DevNum; i++) {
  83   2                      pDev[i].devId = i;
  84   2                      pDev[i].devEn = 0;
  85   2                      pDev[i].devSts = DEV_STS_DISCONNECTED;
  86   2                      pDev[i].devType = DEV_TYPE_UNKNOWN;
  87   2                      //strcpy(pDev[i].devDrv, "0001");
  88   2              }
  89   1      
  90   1              /* Disk attrib initialization */
  91   1              if (DOS_DosRamStsGet() == TRUE) {
  92   2                      pDev[DEV_ID_DISK].devType = DEV_TYPE_DISK_DRAM;
  93   2              } else {
  94   2                      pDev[DEV_ID_DISK].devType = sp1kDiskTypeGet();
  95   2              }
  96   1      
  97   1              /* Panel / TV attrib initialization */
  98   1              if(!sp1kTV_PlugGet()) {
  99   2      
 100   2                      pDev[DEV_ID_PANEL].devSts = DEV_STS_CONNECTED;
 101   2                      pDev[DEV_ID_PANEL].devEn = 0;
 102   2                      pDev[DEV_ID_TV].devSts = DEV_STS_CONNECTED;
 103   2                      pDev[DEV_ID_TV].devEn = 1;
 104   2                      pDev[DEV_ID_TV].devType = DEV_TYPE_TV_COM;
 105   2                      printf("init TV\n");
 106   2              } else {
 107   2                      pDev[DEV_ID_PANEL].devSts = DEV_STS_CONNECTED;
 108   2                      pDev[DEV_ID_PANEL].devEn = 1;
 109   2                      pDev[DEV_ID_PANEL].devType = DEV_TYPE_PANEL_COM;
 110   2                      pDev[DEV_ID_TV].devSts = DEV_STS_DISCONNECTED;
 111   2                      pDev[DEV_ID_TV].devEn = 0;
 112   2              }
 113   1      
 114   1              return SUCCESS;
 115   1      }
