 697   2                      if((UINT32)fac * (UINT32)fac > tmpFac) {
 698   3                              //fac--;        /*if jpg engine can set roi, fac can be odd then. */
 699   3                              fac-=2;         /*width should be multiple of 16*/
 700   3                      } else {
 701   3                              break;
 702   3                      }
 703   2              }
 704   1      
 705   1              if (srcW > dstW) {
 706   2                      //while (((srcW >> 3) * --fac) > dstW);
 707   2                      while (((srcW >> 3) * fac) > dstW)  //modified by rhy,20100328
 708   2                              fac--;
 709   2                      if(fac == 0) {
 710   3                              fac = 1;
 711   3                      }// decopress width < decWidth
 712   2              } else if ( tmpFac > 64) {
 713   2                      fac = 0;
 714   2              }
 715   1      
 716   1              if (fac) {
 717   2              if (((UINT32)srcW * (UINT32)srcH * (UINT32)fac * (UINT32)fac)
 718   2                  > (bufSize << 6)){
 719   3                              DBG_pbFuncTrack();
 720   3                              return 0xff;
 721   3              }        
 722   2              } else {
 723   2              if (((UINT32)srcW * (UINT32)srcH) > (bufSize << 3)){
 724   3                              DBG_pbFuncTrack();
 725   3                              return 0xff;
 726   3              }        
 727   2              }
 728   1      #if (DBG_Level > 1)             
                      DEBUG_PRINT("fac %bu\n", fac); 
C51 COMPILER V8.08   PB_EDIT                                                               12/31/2019 16:15:26 PAGE 13  

              #endif //(DBG_Level > 1)   
 731   1              return fac;
