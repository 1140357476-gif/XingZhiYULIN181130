 679          static UINT8 pbEditScaleFacCal(
 680                  UINT32 bufSize,
 681                  UINT16 srcW,
 682                  UINT16 srcH,
 683                  UINT16 dstW
 684          )
 685          {
 686   1              UINT32 tmpFac;
