1416           * @todo          N/A
1417           * @bug           N/A
1418          */
1419          UINT8 pbJpgDecodeWidthFitFactGet(UINT16 srcW, UINT16 dstW)
1420          {
1421   1              UINT8 fact, fit = 0;
1422   1              UINT16 tmpW;
1423   1              
1424   1              dstW <<= 3; // w*8
1425   1              fact = dstW / srcW;     //nearest
1426   1              if(!fact){
1427   2                      fact = 1;                        // min fact
1428   2              }
1429   1              //find best fact, no need scale
1430   1              if(fact > 8){
1431   2                      fact = 8;          // max fact
1432   2                      fit = 1;
1433   2              }        
1434   1              else if((tmpW=srcW*fact) == dstW){
1435   2                      fit = 1;
1436   2              }
1437   1              else if( (tmpW+=srcW) == dstW){
1438   2                      fact ++;
1439   2                      fit = 1;
1440   2              }        
1441   1              //find fact(2, 4, 6), no need fill black
1442   1              if(!fit){
1443   2                      fact = (fact + 1) & ~1;    
1444   2                      if(srcW*fact & 0x3f)
1445   2                              fact = 4;
1446   2              }
1447   1              fact &= 7;
1448   1              if(fact == 6){
1449   2                      fact=4;
1450   2              }
1451   1              pbLogPrintf("fact:%bu\n", fact);
1452   1              return fact; 
1453   1      }
