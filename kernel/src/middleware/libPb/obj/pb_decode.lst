1407          /**
1408           * @fn            UINT8 pbJpgDecodeWidthFitFactGet(UINT16 srcW, UINT16 dstW)
1409           * @brief         get decode factor
1410           * @param         [in] srcW
1411           * @param         [in] dstW
1412           * @retval        return = SUCCESS / FAIL
1413           * @see           NULL
1414           * @author        Tq.Zhang
