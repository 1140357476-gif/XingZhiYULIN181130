 477          
 478          static void sysMemCbAddrSet(
 479                  memCb_t* pMemCb,
 480                  memCbIdx_t sIdx,
 481                  memCbIdx_t eIdx,
 482                  UINT8 mode,
C51 COMPILER V8.08   SYS_MEM_INIT                                                          07/29/2019 16:04:30 PAGE 9   

 483                  UINT8 bAgn
 484          )
 485          {
 486   1              UINT8 i;
 487   1              //static UINT32 LastAddr=0;
 488   1              //UINT32 LastAddr=0;
 489   1              
 490   1              if (!pMemCb || sIdx > eIdx) {
 491   2                      return;
 492   2              }
 493   1              
 494   1              for (i = sIdx + 1; i <= eIdx; i++) {
 495   2                      if (mode == MEM_GROWTH_UP) {
 496   3                              /* growth up */
 497   3                              pMemCb[i].addr = pMemCb[i - 1].addr + pMemCb[i - 1].size;
 498   3                      } else {
 499   3                              /* growth down */
 500   3                              pMemCb[i].addr = pMemCb[i - 1].addr - pMemCb[i].size;
 501   3                      }
 502   2      
 503   2                      /* alignment to 8 words */
 504   2                      if (bAgn) {
 505   3                              pMemCb[i].addr = (pMemCb[i].addr + 7) & ~7;
 506   3                      }
 507   2                      
 508   2                      //printf(">>addr %08lx\n", (UINT32)pMemCb[i].addr);
 509   2                      //printf(">>addr %08lx, size: %lx\n", (UINT32)pMemCb[i].addr, ((UINT32)pMemCb[i].addr-LastAddr)*2);
 510   2                      //LastAddr = (UINT32)pMemCb[i].addr;
 511   2              }
 512   1      }
