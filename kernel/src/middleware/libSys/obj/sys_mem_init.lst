 559          static void sysMemSizeInit_Global(void)
 560          {
 561   1              UINT32* pSize = &(sgMemCb[MEM_IDX_GLOBAL].size);
 562   1              UINT16 dramSize;
 563   1              
 564   1              switch (XBYTE[REG_Dram_SdramType]) {            
 565   2                      case 0x00:
 566   2                              *pSize = DEV_MEM_SIZE_16M;
 567   2                              break;
 568   2                      case 0x02:
 569   2                              *pSize = DEV_MEM_SIZE_64M;
 570   2                              break;
 571   2                      case 0x03:
 572   2                              *pSize = DEV_MEM_SIZE_128M;
 573   2                              break;
 574   2                      case 0x04:
 575   2                              *pSize = DEV_MEM_SIZE_256M;
 576   2                              break;
 577   2                      case 0x05:
 578   2                              *pSize = DEV_MEM_SIZE_512M;
 579   2                              break;
 580   2                      default:
 581   2                              *pSize = DEV_MEM_SIZE_64M;
 582   2                              break;
 583   2              }
 584   1      
 585   1              dramSize = READP16(pSize, 0) >> 4;
 586   1              printf("DRAM: %ux16Mb@%uMHz\n", dramSize, 522/(XBYTE[0x2025]+1));
 587   1      }
