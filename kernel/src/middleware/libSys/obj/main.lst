 370          /**
 371           * @brief     mainJobDo
 372           * @param     NONE
 373           * @retval    NONE
 374           * @see       none
 375           * @author    Phil Lin
 376           * @since     2010-01-01
 377           * @todo      N/A
 378           * @bug       N/A
 379          */
 380          void
 381          mainJobDo(
 382                  void
 383          )
 384          {
 385   1              UINT32 mainCnt = 0;
 386   1      
 387   1              #if SUPPORT_MCU_WTD
 388   1              static UINT8 flag = 0;
 389   1              static UINT32 dleay_cnt = 0;
 390   1              #endif
 391   1              
 392   1              /*
 393   1                      Note: The uart interrupt always be disabled.
 394   1                      The cmd line request handled by flag pooling
 395   1              */
 396   1              ES0 = 0;
 397   1              while (1) {
 398   2                      mainCnt++;
 399   2      
 400   2                      /* feed the watch dog */
 401   2                      dbgWdtFeed(-1);
 402   2                      
 403   2                      /* Check if there's any Message in Msg-Que */
 404   2                      if (osMsgQuery() == TRUE) {
 405   3                              osMsgRcv();             
 406   3                      }
 407   2      
 408   2                      /* Task schedule */
 409   2                      osSched();
 410   2      
 411   2                      /* system service */
 412   2                      sysSvcSched(&mainCnt);
 413   2      
 414   2                      #if SUPPORT_MCU_WTD
 415   2                      if (check_usb_msdc_flag) {
 416   3                              if (++dleay_cnt == 200/*0xA2C2A*/) {
 417   4                                      dleay_cnt = 0;
 418   4                                      appSetWTDHeartbeat(flag);
 419   4                                      flag = !flag;
 420   4                              }
 421   3                      }
C51 COMPILER V8.08   MAIN                                                                  07/29/2019 16:28:43 PAGE 8   

 422   2                      #endif
 423   2              }
 424   1      }
