  87          void 
  88          sysSvcSched(
  89                  void* ptr
  90          )
  91          {
  92   1              sysSvc_t code* pSvc;
  93   1              UINT8 svcCnt;
  94   1      
  95   1              /* system service switch to idle */
  96   1              pSvc = &sysSvcArray[0];
  97   1              svcCnt = 0;
  98   1      
  99   1              /* system service */
 100   1              while(pSvc->svcProc) {
 101   2                      pSvc->svcProc(ptr);
