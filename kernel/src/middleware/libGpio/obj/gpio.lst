  65          /**
  66           * @fn        UINT8 pkgDedicateGpioGet(UINT8 pinId, UINT8 *pbyteId, UINT8 *pbitMsk, UINT8 *ppolarity)
  67           * @brief     get dedicate gpio pin in current chip package.
  68           * @param     [in] pinId: pin id, one of pkgDedicateGpioPin_e.
  69           * @param     [in] pbyteId: byte id, one of gpioByte_e.
  70           * @param     [in] pbitMsk: bitmap mask.
  71           * @retval    return = SUCCESS / FAIL
  72           * @see       NULL
  73           * @author    kai.wang
  74           * @since     2010-5-17
  75           * @todo        return values *pbyteId and *pbitMsk are used to call following api:
  76           *
  77           *          void  gpioByteFuncSet(UINT8 byteId, UINT8 msk, UINT8 func);
  78           *          UINT8 gpioByteFuncGet(UINT8 byteId, UINT8 msk);
  79           *          void  gpioByteDirSet(UINT8 byteId, UINT8 msk, UINT8 dir);
  80           *          UINT8 gpioByteDirGet(UINT8 byteId, UINT8 msk);
  81           *          void  gpioByteOutSet(UINT8 byteId, UINT8 msk, UINT8 val);
  82           *          UINT8 gpioByteOutGet(UINT8 byteId, UINT8 msk);
  83           *          void  gpioByteInGateSet(UINT8 byteId, UINT8 msk, UINT8 gate);
  84           *          UINT8 gpioByteInGet(UINT8 byteId, UINT8 msk, UINT8 polarity);
  85           * @bug       N/A
  86          */
  87          UINT8
  88          pkgDedicateGpioGet(
  89                  UINT8 pinId,
  90                  UINT8 *pbyteId,
  91                  UINT8 *pbitMsk,
  92                  UINT8 *ppolarity
  93          )
  94          {
  95   1              UINT8 idx;
  96   1      
  97   1      
  98   1              /* search desired dedicate pin. */
  99   1              for ( idx = 0; idx < pkgDedicateGpioTot; idx++ ){
 100   2                      if ( pinId == pkgDedicateGpioTbl[idx].pinId ) {
 101   3                              break;
 102   3                      }
 103   2              }
 104   1      
 105   1              if ( idx < pkgDedicateGpioTot ) {  /* found. */
 106   2                      *pbyteId = pkgDedicateGpioTbl[idx].byteId;
 107   2                      *pbitMsk = pkgDedicateGpioTbl[idx].bitMsk;
 108   2                      *ppolarity = pkgDedicateGpioTbl[idx].polarity;
 109   2              }
 110   1              else {  /* not found. */
 111   2                      *pbyteId = GPIO_BYTE_NULL;
 112   2                      *pbitMsk = (UINT8)NULL;
 113   2              }
 114   1      
 115   1              if ( *pbyteId == GPIO_BYTE_NULL || *pbitMsk == NULL ) {
C51 COMPILER V8.12   GPIO                                                                  12/29/2014 15:17:42 PAGE 3   

 116   2                      *ppolarity = ACTIVE_HIGH;
 117   2                      return FAIL;
 118   2              }
 119   1              else {
 120   2                      return SUCCESS;
 121   2              }
 122   1      }
