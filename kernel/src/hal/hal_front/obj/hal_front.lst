 295          /**
 296           * @fn        void HAL_FrontParaMClkCfgSet(SINT16 *paraAry, UINT8 upd)
 297           * @brief     set front master clk configuration
 298           * @param     [in] paraAry : 
 299           *                                                      [0]: master clk source , 0: internal , 1: external
 300           *                                                      [1]: master clk division factor, 1~256
 301           *                                                      [2]: master clk phase, 0~15, step 1ns
C51 COMPILER V8.08   HAL_FRONT                                                             09/21/2019 10:52:16 PAGE 6   

 302           *                                                      [3]: master clk driving, 0: 2mA, 1: 4mA, 2: 6mA, 3: 8mA
 303           * @param     [in] upd : 
 304           *                                                      0: immediate update 
 305           *                                                      1: update will sync with front vd falling edge  
 306           * @retval    NONE
 307           * @see       NULL
 308           * @author    Will Chiu
 309           * @since     2010-4-30
 310           * @todo      N/A
 311           * @bug       N/A
 312          */
 313          void
 314          HAL_FrontParaMClkCfgSet(
 315                  SINT16 *paraAry,
 316                  UINT8 upd
 317          )
 318          {
 319   1              /* set vclk2xsel. */
 320   1              XBYTE[0x2019] = (XBYTE[0x2019] & ~0x04) | paraAry[0];
 321   1      
 322   1              /* set vclk2xdiv. */
 323   1              if ( paraAry[1] >= 256 ) {
 324   2                      paraAry[1] = 255;
 325   2              }
 326   1              else if ( paraAry[1] > 0 ) {
 327   2                      paraAry[1]--;
 328   2              }
 329   1              XBYTE[0x2027] = paraAry[1];
 330   1      
 331   1              /* set Chphase[7:4]. */
 332   1              XBYTE[0x20E3] = (XBYTE[0x20E3] & ~0xF0) | (paraAry[2] << 4);
 333   1      
 334   1              /* set mclkdrive. */
 335   1              XBYTE[0x2064] = (XBYTE[0x2064] & ~0xC0) | (paraAry[3] << 6);
 336   1      
 337   1              /* set vclk2xdivstsel. */
 338   1              XBYTE[0x202B] = upd;
 339   1      }
