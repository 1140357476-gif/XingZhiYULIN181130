  63          /**
  64           * @fn        void HAL_FrontIntrEnable(UINT32 enable, UINT8 value)
  65           * @brief     enable/disable front interrupt
  66           * @param     [in] enable : 
  67           *                                                      0: disable
  68           *                                                      1: enable 
  69           * @param     [in] value :
  70           *                                                      [0] : VD rise
  71           *                                                      [1] : VD fall
  72           *                                                      [2] : Serial done
  73           *                                                      [3] : Snap done
  74           *                                                      [4] : Clear CDSP do done
  75           *                                                      [5] : Front valid rise
  76           *                                                      [6] : Front valid falling
  77           *                                                      [7] : 
  78           *                                                      [8] : 
  79           *                                                      [9] : 
  80           *                                                      [10]: 
  81           * @retval    NONE
  82           * @see       NULL
  83           * @author    Will Chiu
  84           * @since     2010-4-30
  85           * @todo      N/A
  86           * @bug       N/A
  87          */
  88          void
  89          HAL_FrontIntrEnable(
  90                  UINT8 enable,
  91                  UINT8 value
  92          )
  93          {
  94   1              /* set Finten and FintEvt. */
  95   1              if (enable) {
  96   2                      XBYTE[REG_Front_Finten_low] |= value;
  97   2                      XBYTE[REG_Front_FintEvt_low] |= value;  /* clear intrrupt */
  98   2              }
  99   1              else {
 100   2                      XBYTE[REG_Front_Finten_low] &= ~value;
 101   2                      XBYTE[REG_Front_FintEvt_low] |= value; /* clear intrrupt */
 102   2              }
 103   1      
 104   1              /* set VDFintNum and VDRintNum. */
 105   1              XBYTE[REG_Front_VDRIntNum] = 0x11;  //set VD rising and falling number = 1
 106   1      }
