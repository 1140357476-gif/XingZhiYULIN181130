 233   3                              /* set pwm0select */
 234   3                              if (func & msk & 0x10) {
 235   4                                      XBYTE[0x201B] &= ~0x01; /* set to gpio */ 
 236   4                              }
 237   3                              else {
 238   4                                      XBYTE[0x201B] |= 0x01; /* set to function */ 
 239   4                              }
