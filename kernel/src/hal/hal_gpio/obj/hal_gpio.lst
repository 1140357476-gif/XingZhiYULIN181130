 193          /**
 194           * @fn        void HAL_GpioByteFuncSet(UINT8 byteId, UINT8 msk, UINT8 func)
 195           * @brief     set gpio function in byte.
 196           * @param     [in] byteId: byte id, one of HAL_GpioByte_e.
 197           * @param     [in] msk: bitmap mask.
 198           * @param     [in] func: bitmap function, 0: function, 1: gpio.
 199           * @              Please Note that the FMGPIO can only set to gpio not function! 
 200           * @retval    NONE
 201           * @see       NULL
 202           * @author    kai.wang
 203           * @since     2010-4-27
 204           * @todo      N/A
 205           * @bug       N/A
 206          */
 207          #pragma disable //disable interrupt
 208          void
 209          HAL_GpioByteFuncSet(
 210                  UINT8 byteId,
 211                  UINT8 msk,
 212                  UINT8 func
 213          )
 214          {
 215   1              UINT16 reg;
 216   1      
 217   1      
 218   1              #if HAL_GPIO_BYTE_FUNC_SET_DBG
