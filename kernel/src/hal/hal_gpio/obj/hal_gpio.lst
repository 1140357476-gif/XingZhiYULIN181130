1820          /**
1821           * @fn        UINT8 HAL_GpioSarAdcConfig(UINT8 pwrctl, UINT8 channel, UINT8 sarclk)
1822           * @brief     config adc group
1823           * @param     [in] tp_en:
1824           *                                      0: Disable. SARIN3 is used as the same way as SAR0, SAR1 and SAR2.
1825           *                                      1: Enable. SRARIN3 can be used as an touch panel input, in which tp_intnint_evt interrupt is availa
             -ble.
1826           * @param     [in] sarclk:
1827           *                                      0: ADC CLK=250KHz,  maximum sample frequency=15.625KHz
1828           *                                      1: ADC CLK=500KHz,  maximum sample frequency=31.25KHz
1829           *                                      2: ADC CLK=1MHz,  maximum sample frequency=62.5KHz 
1830           *                                      3: ADC CLK=2MHz, maximum sample frequency=125KHz
1831           * @param     [in] pwrctl:
1832           *                                      0: power down
1833           *                                      1: normal operation
1834           * @retval    return = SUCCESS / FAIL
1835           * @see       NULL
1836           * @author    kai.wang
1837           * @since     2010-5-9
1838           * @todo      N/A
1839           * @bug       N/A
1840          */
1841          #pragma disable //disable interrupt
1842          UINT8 HAL_GpioSarAdcConfig(
1843                  UINT8 tp_en,
1844                  UINT8 sarclk,
1845                  UINT8 pwrctl
1846          )
1847          {
1848   1              XBYTE[0x2014] = 0xFF;
1849   1              XBYTE[0x2015] |= 0x01;
1850   1              XBYTE[0x2016] |= 0x02;
C51 COMPILER V8.08   HAL_GPIO                                                              02/18/2022 10:00:52 PAGE 31  

1851   1              /* Enable vref */
1852   1              XBYTE[REG_Audio_VrefPwrEn] =0x05;
1853   1              /*Enable SRARIN3 be used as an touch panel input*/
1854   1              if ( tp_en ) {
1855   2                      XBYTE[REG_Audio_SarAdcPwrEn] = 0x02;
1856   2              }
1857   1      
1858   1              /*SAR ADC clock frequency selection*/
1859   1              if ( sarclk == 0x00 ) { /*ADC CLK=250KHz,*/
1860   2                      XBYTE[REG_Audio_SarClkSel] = 0x00;
1861   2              }
1862   1              else if ( sarclk == 0x01 ) { /*ADC CLK=500KHz,*/
1863   2                      XBYTE[REG_Audio_SarClkSel] = 0x01;      
1864   2              }
1865   1              else if ( sarclk == 0x02 ) { /*ADC CLK=1MHz,*/
1866   2                      XBYTE[REG_Audio_SarClkSel] = 0x02;
1867   2              }
1868   1              else if ( sarclk == 0x03 ) { /*ADC CLK=2MHz,*/
1869   2                      XBYTE[REG_Audio_SarClkSel] = 0x03;
1870   2              }
1871   1              else {
1872   2                      return FAIL;
1873   2              }
1874   1              /*SAR ADC enable*/
1875   1              if ( pwrctl == 1 ) { /*normal operation*/
1876   2                      XBYTE[REG_Audio_SarAdcPwrEn] |= 0x01;
1877   2              }
1878   1              else {
1879   2                      XBYTE[REG_Audio_SarAdcPwrEn] &= 0xFE; /*power down*/
1880   2              }
1881   1              return SUCCESS;
1882   1      }
