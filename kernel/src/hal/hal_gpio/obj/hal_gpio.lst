1906          {
1907   1              /* SAR ADC input selection */
1908   1              if ( channel == 0x00 ) { /*SAR 0*/
1909   2                      XBYTE[REG_Audio_SarChnlSel] = 0x00;
1910   2              }
1911   1              else if ( channel == 0x01 ) { /*SAR 1*/
1912   2                      XBYTE[REG_Audio_SarChnlSel] = 0x01;
C51 COMPILER V8.08   HAL_GPIO                                                              02/18/2022 10:00:52 PAGE 32  

1913   2              }
1914   1              else if ( channel == 0x02 ) { /*SAR 2*/
1915   2                      XBYTE[REG_Audio_SarChnlSel] = 0x02;
1916   2              }
1917   1              else if ( channel == 0x03 ) { /*SAR 3*/
1918   2                      XBYTE[REG_Audio_SarChnlSel] = 0x03;
1919   2              }
1920   1              else if ( channel == 0x04 ) { /*SAR 4*/
1921   2                      XBYTE[REG_Audio_SarChnlSel] = 0x04;
1922   2              }
1923   1              else {
1924   2                      return FAIL;
1925   2              }
1926   1              HAL_GlobalTimerWait(5);
1927   1              
1928   1              XBYTE[REG_Audio_SnapSarAdcVal0] = 0x01; /* snap adc data */
1929   1              *adcval = ( (XBYTE[REG_Audio_SnapSarAdcVal1]^0x02) <<8) | (XBYTE[REG_Audio_SnapSarAdcVal0]);
1930   1      
1931   1              return SUCCESS;
1932   1      }


