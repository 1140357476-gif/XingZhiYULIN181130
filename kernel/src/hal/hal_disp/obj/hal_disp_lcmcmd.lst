  70          UINT8
  71          HAL_DispLcmCmdTableSend(
  72                  UINT32 *cmdTbl
  73          )
  74          {
  75   1              UINT8 run, cmdHdr;
  76   1              UINT32 cmd;
  77   1              UINT8 pinWR;
  78   1      
  79   1              /* if dispEn or dispPhaseClkEn disabled, no need to send. */
  80   1              if ( !(XBYTE[REG_Disp_DispEn_Flip] & 0x01) || !(XBYTE[0x2013] & 0x10) ) {
  81   2              //printf("disp disable\n");
  82   2                      return FAIL;
  83   2              }
  84   1      
  85   1              /* wait current frame data done. */
  86   1              XBYTE[REG_Disp_LcmVSUpd_DmaEn] &= ~0x10;  /* disable dma. */
  87   1              while ( XBYTE[REG_Disp_LcmVSUpd_DmaEn] & 0x20 ) {  /* wait current frame image data done. */
  88   2              }
  89   1      
  90   1      #if LCM_CMD_GPIO_CTRL   
  91   1              /* check the WR active */
  92   1              if (XBYTE[REG_Disp_LcmMode_BusW] & 0x01) {
  93   2                      pinWR = 0x01; //M68
  94   2              } else {
  95   2                      pinWR = 0x00; //i80
  96   2              }
  97   1              HAL_GpioByteFuncSet(HAL_GPIO_BYTE_DISP1, 0x01 << (11 & 0x07), 0x01 << (11 & 0x07));
  98   1              HAL_GpioByteOutSet(HAL_GPIO_BYTE_DISP1, 0x01 << (11 & 0x07), !pinWR << (11 & 0x07));
  99   1              HAL_GpioByteDirSet(HAL_GPIO_BYTE_DISP1, 0x01 << (11 & 0x07), 0x01 << (11 & 0x07));
 100   1      #endif
 101   1          
 102   1          /* write command main body. */
 103   1          XBYTE[REG_Disp_LcmCmdCtrl] |= 0x01; // enable command mode
 104   1              XBYTE[REG_Disp_LcmCS_RS] = HAL_DispCs0Act | HAL_DispA0Cmd;
 105   1          run = 1;
 106   1      
 107   1          while(run) {
 108   2                      cmdHdr = READ8(*cmdTbl, 0);
 109   2                      cmd = *cmdTbl & 0x00FFFFFFL;
 110   2      #if 0
                              printf("cmdHdr=0x%02X cmd=0x%06lX\n", (UINT16)cmdHdr, cmd);
              #endif
 113   2      
 114   2                      if ( cmdHdr <= HAL_DISP_LCM_CMD_HDR_PARA ) {
 115   3                              if ( cmdHdr == HAL_DISP_LCM_CMD_HDR_INST ) {
C51 COMPILER V8.08   HAL_DISP_LCMCMD                                                       12/30/2019 16:31:05 PAGE 3   

 116   4                                      XBYTE[REG_Disp_LcmCS_RS] = HAL_DispCs0Act | HAL_DispA0Cmd;
 117   4                              }
 118   3                              else {  /* HAL_DISP_LCM_CMD_HDR_PARA. */
 119   4                                      XBYTE[REG_Disp_LcmCS_RS] = HAL_DispCs0Act | HAL_DispA0Data;
 120   4                              }        
 121   3                              XBYTE[REG_Disp_LcmAutoCmd00] = READ8(cmd, 3);  /* lcmcmd[7:0]   */
 122   3                              XBYTE[REG_Disp_LcmAutoCmd01] = READ8(cmd, 2);  /* lcmcmd[15:8]  */
 123   3                              XBYTE[REG_Disp_LcmAutoCmd02] = READ8(cmd, 1);  /* lcmcmd[17:16] */
 124   3      
 125   3      #if !LCM_CMD_GPIO_CTRL            
                                      XBYTE[REG_Disp_LcmPioTrg_Busy] = 0x01;  /* trig piowrite. */
                                      while(XBYTE[REG_Disp_LcmPioTrg_Busy] & 0x10); /* wait command finish */
              #else
 129   3                              HAL_GpioByteOutSet(HAL_GPIO_BYTE_DISP1, 0x01 << (11 & 0x07), pinWR << (11 & 0x07));
 130   3                              HAL_GpioByteOutSet(HAL_GPIO_BYTE_DISP1, 0x01 << (11 & 0x07), !pinWR << (11 & 0x07));
 131   3      #endif
 132   3                      }
 133   2                      else if ( cmdHdr == HAL_DISP_LCM_CMD_HDR_WAIT ) {
 134   3                              HAL_GlobalTimerWait(cmd);
 135   3                      }
 136   2                      else {  /* HAL_DISP_LCM_CMD_HDR_STOP. */
 137   3                              run = 0;
 138   3                      }
 139   2      
 140   2                      cmdTbl++;
 141   2              
 142   2          }
 143   1      
 144   1      #if LCM_CMD_GPIO_CTRL
 145   1              HAL_GpioByteFuncSet(HAL_GPIO_BYTE_DISP1, 0x01 << (11 & 0x07), 0x00 << (11 & 0x07));
 146   1      #endif
 147   1      
 148   1              /* restore to frame data mode. */
 149   1              XBYTE[REG_Disp_LcmCmdCtrl] &= ~0x01;  /* disable command mode. */
 150   1              XBYTE[REG_Disp_LcmCS_RS] = HAL_DispCs0Act | HAL_DispA0Data;
 151   1              XBYTE[REG_Disp_LcmVSUpd_DmaEn] |= 0x10;  /* enable dma. */
 152   1      
 153   1              return SUCCESS;
 154   1      }
