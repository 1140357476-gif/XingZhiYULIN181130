1061   2                      mtxVal = pMtxB[i8];
1062   2                      //printf("b mtxVal: %lx\n", (UINT32)mtxVal);
1063   2                      XBYTE[REG_Disp_ColB00H + i8] = READ8(mtxVal, 0); //format S7.4
1064   2      
