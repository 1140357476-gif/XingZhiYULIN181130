1067   3                              valShift = 4;
1068   3                      } else {
1069   3                              valShift = 0;
1070   3                      }
1071   2      
1072   2                      XBYTE[REG_Disp_ColB00L01L + (i8 >> 1)] = (XBYTE[REG_Disp_ColB00L01L + (i8 >> 1)] & ~(0x07 << valShift)) 
             -| \
1073   2                      (READ8(mtxVal, 1) << valShift);
1074   2              }
1075   1      }
