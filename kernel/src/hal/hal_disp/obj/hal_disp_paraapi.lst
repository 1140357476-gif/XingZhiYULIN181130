 161          /**
 162           * @fn        void HAL_DispParaClkEnableSet(SINT16 *paraAry)
 163           * @brief     enable/disable display clk
 164           * @param     paraAry[0] = [in] 0: disable, 1: enable
 165           * @param     paraAry[1] = [in] N/A, fill 0
 166           * @param     paraAry[2] = [in] N/A, fill 0
 167           * @param     paraAry[3] = [in] N/A, fill 0
 168           * @retval    NONE
 169           * @see       NULL
 170           * @author    Phil Lin
 171           * @since     2010-4-27
 172           * @todo      N/A
 173           * @bug       N/A
 174          */
 175          void
 176          HAL_DispParaClkEnableSet(
 177                  SINT16 *paraAry
C51 COMPILER V8.08   HAL_DISP_PARAAPI                                                      12/30/2019 16:39:18 PAGE 4   

 178          )
 179          {
 180   1              if ( paraAry[0] ) {
 181   2                      /* enable display nx clk & 1x clk. */
 182   2                      XBYTE[0x2013] |= 0x10;
 183   2      
 184   2                      /* enable display mclk. */
 185   2                      XBYTE[0x2015] |= 0x08;
 186   2              }
 187   1              else {
 188   2                      /* disable display nx clk & 1x clk. */
 189   2                      XBYTE[0x2013] &= ~0x10;
 190   2      
 191   2                      /* disable display mclk. */
 192   2                      XBYTE[0x2015] &= ~0x08;
 193   2              }
 194   1      }
 195          
 196          /**
 197           * @fn        void HAL_DispParaClkCfgSet(SINT16 *paraAry)
 198           * @brief     set display clk configuration
 199           * @param     paraAry[0] = [in] clk source, one of HAL_DispClkSrc_e
 200           * @param     paraAry[1] = [in] N/A, fill 0
 201           * @param     paraAry[2] = [in] N/A, fill 0
 202           * @param     paraAry[3] = [in] N/A, fill 0
 203           * @retval    NONE
 204           * @see       NULL
 205           * @author    Phil Lin
 206           * @since     2010-4-27
 207           * @todo      N/A
 208           * @bug       N/A
 209          */
 210          void
 211          HAL_DispParaClkCfgSet(
 212                  SINT16 *paraAry
 213          )
 214          {
 215   1              /* set dispclksel. */
 216   1              XBYTE[0x2019] = (XBYTE[0x2019] & ~0x01) | paraAry[0];
 217   1      
 218   1              /* set dispnxdiv. */
 219   1              if ( paraAry[1] >= 256 ) {
 220   2                      paraAry[1] = 255;
 221   2              }
 222   1              else if ( paraAry[1] > 0 ) {
 223   2                      paraAry[1]--;
 224   2              }
 225   1              XBYTE[0x2028] = paraAry[1];
 226   1      
 227   1              /* set disp1xdiv. */
 228   1              if ( paraAry[2] >= 4 ) {
 229   2                      paraAry[2] = 3;
 230   2              }
 231   1              else if ( paraAry[2] > 0 ) {
 232   2                      paraAry[2]--;
 233   2              }
 234   1              XBYTE[0x2029] = paraAry[2];
 235   1      }
