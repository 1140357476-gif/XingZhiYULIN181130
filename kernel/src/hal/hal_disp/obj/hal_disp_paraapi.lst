 136          /**
 137           * @fn        void HAL_DispParaSwRst(SINT16 *paraAry)
 138           * @brief     Reset display module
 139           * @param     paraAry[0] = [in] reset device, one of dispRstDev_e.
 140           * @param     paraAry[1] = [in] N/A, fill 0.
 141           * @param     paraAry[2] = [in] N/A, fill 0.
 142           * @param     paraAry[3] = [in] N/A, fill 0.
 143           * @retval    NONE
 144           * @see       NULL
 145           * @author    Phil Lin
 146           * @since     2010-4-27
 147           * @todo      N/A
 148           * @bug       N/A
 149          */
 150          void
 151          HAL_DispParaSwRst(
 152                  SINT16 *paraAry
 153          )
 154          {
 155   1              XBYTE[REG_Disp_SwRst] |= paraAry[0];
 156   1              XBYTE[REG_Disp_SwRst] &= ~0x10; //panel clock enable
 157   1              XBYTE[REG_Disp_SwRst] &= ~paraAry[0];
 158   1              XBYTE[REG_Disp_SwRst] |= 0x10; //panel clock enable
 159   1      }
