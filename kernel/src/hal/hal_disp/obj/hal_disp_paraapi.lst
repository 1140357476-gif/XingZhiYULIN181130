 331          /**
 332           * @fn        void HAL_DispParaImgLayerFlipSet(SINT16 *paraAry)
 333           * @brief     set horizontal and vertical flip of image layer
 334           * @param     paraAry[0] = [in] bitmap [1:0] flip value, bit 0: hflip, bit 1: vflip
 335           * @param     paraAry[1] = [in] bitmap [1:0] mask, bit 0: hflip, bit 1: vflip
 336           * @param     paraAry[2] = [in] N/A, fill 0
 337           * @param     paraAry[3] = [in] N/A, fill 0
 338           * @retval    NONE
 339           * @see       NULL
 340           * @author    Phil Lin
 341           * @since     2010-4-28
 342           * @todo      N/A
 343           * @bug       N/A
 344          */
 345          void
 346          HAL_DispParaImgLayerFlipSet(
 347                  SINT16 *paraAry
 348          )
 349          {
 350   1              /* set hflip & vflip. */
 351   1              paraAry[0] <<= 4;       /* bit 4: hflip, bit 3: vflip. */
 352   1              paraAry[1] <<= 4;       /* bit 4: hflip, bit 3: vflip. */
 353   1              XBYTE[REG_Disp_DispEn_Flip] = (XBYTE[REG_Disp_DispEn_Flip] & ~paraAry[1]) | (paraAry[0] & paraAry[1]);
 354   1      }
