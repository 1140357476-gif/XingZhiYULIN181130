  52          /*
  53            pnlHSclFac = (PNLIMGH_IN - 1) * 4096 / (PNLIMGH_OUT - 1)
C51 COMPILER V8.08   HAL_DISP_API                                                          12/30/2019 16:31:05 PAGE 2   

  54            pnlVSclFac = (PNLIMGV_IN - 1) * 8192 / (PNLIMGV_OUT - 1)
  55          */
  56          #define HAL_DispScaleFacCalculate(srcH, srcV, dstH, dstV, facH, facV) \
  57          {\
  58                  (facH) = ((srcH) == (dstH)) ? 4096 : ((((srcH) - 1) << 12) / ((dstH) - 1));\
  59                  if ((XBYTE[REG_Disp_FieldEnSwap] & 0x01) && ((XBYTE[REG_Disp_SclMode] & 0x04) == 0)) dstV >>= 1;\
  60                  (facV) = ((srcV) == (dstV)) ? 8192 : ((((srcV) - 1) << 13) / ((dstV) - 1));\   
  61          }
  62          
  63          /*
  64            pnlHSclIni = ((PNLIMGH_IN - 1) * 4096 - pnlHSclFac * (PNLIMGH_OUT - 1)) / 2
  65            pnlVSclIni = ((PNLIMGV_IN - 1) * 8192 - pnlVSclFac * (PNLIMGV_OUT - 1)) / 2
  66          */
  67          #define HAL_DispScaleIniCalculate(srcH, srcV, dstH, dstV, pnlHSclFac, pnlVSclFac, facIniH, facIniV) \
  68          {\
  69                  (facIniH) = ((((srcH) - 1) << 12) - (pnlHSclFac) * ((dstH) - 1)) >> 1;\
  70                  (facIniV) = ((((srcV) - 1) << 13) - (pnlVSclFac) * ((dstV) - 1)) >> 1;\   
  71          }
